{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"$CLAUDE_TOOL_INPUT\" | grep -q \"git commit\" && node ~/sandforge/eval/run.mjs || true'",
            "description": "Run eval/run.mjs before any git commit to enforce the eval-green gate"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node eval/run.mjs)",
      "Bash(node dispatch/pick-runtime.mjs *)",
      "Bash(node observability/append-run.mjs *)",
      "Bash(git -C ~/sandforge *)"
    ]
  }
}
