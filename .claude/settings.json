{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/template-guard.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/hooks/template-guard.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node eval/run.mjs)",
      "Bash(node dispatch/pick-runtime.mjs *)",
      "Bash(node observability/append-run.mjs *)",
      "Bash(node bin/sandforge.mjs *)",
      "Bash(npm test)",
      "Bash(npm run eval)"
    ]
  }
}
